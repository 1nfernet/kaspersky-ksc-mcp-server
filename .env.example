KSC_HOST=ksc.example.com
KSC_PORT=13299
# Basis-Auth ( interner User: KSC_INTERNAL=1, Domaenen-User: KSC_INTERNAL=0 + KSC_DOMAIN )
KSC_USER=api-readonly-user
KSC_PASS=change-me
KSC_DOMAIN=
KSC_INTERNAL=0
# Alternativ Token-Auth (hat Vorrang, wenn gesetzt):
# KSC_TOKEN=
# Virtueller Server (optional):
# KSC_VSERVER=
# TLS: false fuer selbstsigniertes klserver.cer, oder Pfad zur .cer
KSC_VERIFY=false
KSC_TIMEOUT=30
